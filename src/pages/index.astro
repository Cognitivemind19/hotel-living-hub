---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoomCard from '../components/RoomCard.astro';
import site from '../data/site.json';
import rooms from '../data/rooms.json';
---
<BaseLayout>
  <section class="hero">
    <div class="container">
      <h1>{site.name}</h1>
      <p class="lead">{site.tagline}</p>
      <div class="actions">
        <a class="btn" href="/book/">Check availability</a>
        <a class="btn btn-whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp us</a>
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Amenities</h2>
    <ul class="tags">
      {site.amenities.map((a) => <li>{a}</li>)}
    </ul>
  </section>

  <section class="section container">
    <h2>Our rooms</h2>
    <div class="grid">
      {rooms.map((room) => <RoomCard room={room} />)}
    </div>
  </section>

  <section class="section container">
    <h2>What guests say</h2>
    <p class="muted">Add 2–3 of your best Google reviews here once the Google Business Profile is live.</p>
  </section>
</BaseLayout>

<style>
  .hero {
    background: linear-gradient(rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.45)), url('/images/hero.webp') center / cover, var(--brand-dark);
    color: #fff;
    padding: 96px 0;
  }
  .hero h1 { font-size: clamp(2rem, 5vw, 3.2rem); }
  .lead { font-size: 1.2rem; margin: 8px 0 24px; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; }
</style>
