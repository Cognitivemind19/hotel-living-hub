---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSlider from '../components/HeroSlider.astro';
import RoomCard from '../components/RoomCard.astro';
import AvailabilityBar from '../components/AvailabilityBar.astro';
import BookingCta from '../components/BookingCta.astro';
import site from '../data/site.json';
import rooms from '../data/rooms.json';
import venues from '../data/venues.json';
import offers from '../data/offers.json';
import { discount } from '../lib/offer';

const services = offers.filter((o) => o.web);

const photos = [
  { src: '/images/gallery/reception.webp', alt: 'Hotel reception' },
  { src: '/images/dining/taste-point-2.webp', alt: 'Taste Point restaurant' },
  { src: '/images/rooms/suite-3.webp', alt: 'Suite sitting room' },
  { src: '/images/dining/madira-2.webp', alt: 'Madira lounge bar' },
];
---
<BaseLayout>
  <div class="sent-notice" id="sent-notice" role="status" hidden>
    <div class="container">
      <p><strong>Thank you!</strong> Your message has been sent. We'll get back to you soon.</p>
      <button type="button" aria-label="Dismiss message" data-dismiss>&times;</button>
    </div>
  </div>

  <HeroSlider />

  <div class="container availability-wrap">
    <AvailabilityBar />
  </div>

  <section class="section container">
    <h2>Book online, save {discount}%</h2>
    <p class="muted lead">Rooms, restaurant tables, food delivery and the banquet hall: book any of them through this website and get {discount}% off.</p>
    <div class="services">
      {services.map((s) => (
        <a class="card service" href={s.href}>
          <div class="pic"><img src={s.image} alt="" loading="lazy" width="800" height="600" /><span class="flag">{discount}% OFF</span></div>
          <div class="card-body">
            <h3>{s.title}</h3>
            <p class="muted">{s.description}</p>
            <span class="go">{s.cta} →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section container">
    <h2>Rooms &amp; accommodation</h2>
    <div class="grid">
      {rooms.map((room) => <RoomCard room={room} />)}
    </div>
    <p class="more"><a href="/rooms/">See room details and photos</a></p>
  </section>

  <section class="section band">
    <div class="container">
      <h2>Dine, unwind and celebrate</h2>
      <div class="grid">
        {venues.map((v) => (
          <article class="card">
            <img src={v.image} alt={v.name} loading="lazy" width="800" height="600" />
            <div class="card-body">
              <h3>{v.name}</h3>
              <p class="muted">{v.type}</p>
              <p class="more"><a href={v.href}>Learn more</a></p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section container">
    <h2>Amenities</h2>
    <ul class="tags">
      {site.amenities.map((a) => <li>{a}</li>)}
    </ul>
    <p class="more"><a href="/amenities/">All amenities &amp; facilities</a></p>
  </section>

  <section class="section container split">
    <div>
      <h2>Weddings, meetings and functions</h2>
      <p>Sabha – The Banquet hosts corporate events, marriages, family functions, social events and political meetings, with catering from Taste Point and rooms for your guests.</p>
      <div class="btns">
        <a class="btn" href="/banquet/">Book the banquet hall</a>
        <a class="btn btn-outline" href="/corporate/">Corporate stays</a>
      </div>
    </div>
    <img src="/images/dining/sobha-3.webp" alt="Sabha banquet hall set up with round tables" loading="lazy" width="800" height="600" />
  </section>

  {site.reviews.length > 0 && (
    <section class="section container">
      <h2>What guests say</h2>
      <div class="grid">
        {site.reviews.map((r: { quote: string; name: string }) => (
          <blockquote class="card card-body">
            <p>“{r.quote}”</p>
            <footer class="muted">{r.name}</footer>
          </blockquote>
        ))}
      </div>
    </section>
  )}

  <section class="section container">
    <h2>A look inside</h2>
    <div class="photo-row">
      {photos.map((p) => <img src={p.src} alt={p.alt} loading="lazy" width="800" height="600" />)}
    </div>
    <p class="more"><a href="/gallery/">View the full gallery</a></p>
  </section>

  {site.mapEmbedUrl && (
    <section class="section container split">
      <div>
        <h2>Find us</h2>
        <p>{site.address}</p>
        <a class="btn" href={site.mapUrl} target="_blank" rel="noopener" style="margin-top:14px">Open in Google Maps</a>
      </div>
      <iframe class="map" src={site.mapEmbedUrl} loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Map to Hotel Living Hub"></iframe>
    </section>
  )}

  <BookingCta />
</BaseLayout>

<script>
  import { FORM_SENT_KEY } from '../scripts/form-sent';

  // Web3Forms lands here with ?sent=1 after a successful submission.
  const url = new URL(location.href);
  if (url.searchParams.get('sent') === '1') {
    const notice = document.getElementById('sent-notice')!;
    notice.hidden = false;
    notice.querySelector('[data-dismiss]')!.addEventListener('click', () => (notice.hidden = true));
    try { sessionStorage.setItem(FORM_SENT_KEY, '1'); } catch {}
    url.searchParams.delete('sent');
    history.replaceState(null, '', url.pathname + url.search + url.hash);
  }
</script>

<style>
  .sent-notice { background: #e6f4ea; border-bottom: 2px solid var(--forest); color: var(--forest-dark); }
  .sent-notice[hidden] { display: none; }
  .sent-notice .container { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 14px 0; }
  .sent-notice button { background: none; border: 0; font-size: 1.6rem; line-height: 1; color: inherit; cursor: pointer; padding: 4px 8px; border-radius: 6px; }
  .sent-notice button:focus-visible { outline: 2px solid var(--forest); }
  .availability-wrap { margin-top: -56px; position: relative; z-index: 2; }
  .more { margin-top: 12px; font-weight: 600; }
  .lead { margin: -8px 0 18px; }
  .services { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); }
  .service { color: inherit; text-decoration: none; display: grid; grid-template-rows: auto 1fr; transition: border-color 0.15s, box-shadow 0.15s; }
  .service:hover { border-color: var(--forest); box-shadow: 0 6px 18px rgb(0 0 0 / 0.08); }
  .service:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; }
  .service h3 { font-size: 1.1rem; }
  .service .muted { font-size: 0.92rem; margin: 4px 0 8px; }
  .go { color: var(--forest); font-weight: 700; }
  .pic { position: relative; }
  .flag { position: absolute; top: 10px; left: 10px; background: var(--brand); color: #fff; font-weight: 700; font-size: 0.8rem; padding: 3px 10px; border-radius: 99px; }
  .btns { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 14px; }
  .btn-outline { background: #fff; color: var(--forest); border: 1.5px solid var(--forest); }
  .btn-outline:hover { background: #e7f0ea; }
  .split { display: grid; gap: 28px; grid-template-columns: 1fr 1fr; align-items: center; }
  .split img { border-radius: var(--radius); aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .map { width: 100%; aspect-ratio: 4 / 3; border: 0; border-radius: var(--radius); background: var(--surface); }

  @media (max-width: 720px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
