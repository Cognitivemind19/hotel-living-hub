---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookingCta from '../components/BookingCta.astro';
import rooms from '../data/rooms.json';
---
<BaseLayout title="Rooms & Accommodation" description="Deluxe, Executive and Suite rooms at Hotel Living Hub, with photos and amenities.">
  <PageHero title="Rooms & Accommodation" lead="Send us your dates and we'll share the best available rate." image="/images/rooms/executive.webp" />

  <section class="section container rooms">
    {rooms.map((room) => (
      <article class="room" id={room.slug}>
        <div class="main">
          <img src={room.image} alt={room.name} loading="lazy" width="800" height="600" />
          <div>
            <h2>{room.name}</h2>
            <p class="muted">{room.bed}{room.guests && ` · Up to ${room.guests} guests`}</p>
            <p class="desc">{room.description}</p>
            <ul class="tags">
              {room.amenities.map((a) => <li>{a}</li>)}
            </ul>
            {room.price
              ? <p><strong>From ₹{room.price.toLocaleString('en-IN')}</strong> / night</p>
              : <p class="muted">Contact us for today's rate</p>}
            <a class="btn" href={`/book/?room=${room.slug}`} style="margin-top:12px">Book this room</a>
          </div>
        </div>
        <div class="photo-row">
          {room.photos.map((p) => <img src={p.src} alt={p.alt} loading="lazy" width="800" height="600" />)}
        </div>
      </article>
    ))}
  </section>

  <BookingCta />
</BaseLayout>

<style>
  .rooms { display: grid; gap: 56px; }
  .room { display: grid; gap: 12px; }
  .main { display: grid; gap: 28px; grid-template-columns: 1.2fr 1fr; align-items: center; }
  .main img { border-radius: var(--radius); aspect-ratio: 4 / 3; object-fit: cover; width: 100%; background: var(--surface); }
  .main h2 { margin-bottom: 4px; }
  .desc { margin-top: 10px; }

  @media (max-width: 720px) {
    .main { grid-template-columns: 1fr; gap: 14px; }
  }
</style>
