---
import BaseLayout from '../layouts/BaseLayout.astro';
import RoomCard from '../components/RoomCard.astro';
import rooms from '../data/rooms.json';
---
<BaseLayout title="Rooms" description="Room types, amenities and rates at Hotel Living Hub.">
  <section class="section container">
    <h1>Rooms & Rates</h1>
    <p class="muted">Rates are per night and may vary on festivals and weekends.</p>
    <div class="grid" style="margin-top:24px">
      {rooms.map((room) => <RoomCard room={room} />)}
    </div>
  </section>
</BaseLayout>
