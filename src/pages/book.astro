---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
import rooms from '../data/rooms.json';
---
<BaseLayout title="Book" description="Send a booking enquiry to Hotel Living Hub or reach us on WhatsApp.">
  <section class="section container">
    <h1>Book your stay</h1>
    <p class="muted">Fastest response: WhatsApp or call. Or send the form and we'll confirm availability.</p>

    <div class="actions">
      <a class="btn btn-whatsapp" href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">WhatsApp</a>
      <a class="btn" href={`tel:${site.phone.replace(/\s/g, '')}`}>Call {site.phone}</a>
    </div>

    <!-- Web3Forms: get a free access key at web3forms.com and set formAccessKey in src/data/site.json -->
    <form action="https://api.web3forms.com/submit" method="POST">
      <input type="hidden" name="access_key" value={site.formAccessKey} />
      <input type="hidden" name="subject" value={`New booking enquiry — ${site.name}`} />
      <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

      <label>Name <input name="name" required autocomplete="name" /></label>
      <label>Phone <input name="phone" type="tel" required autocomplete="tel" /></label>
      <div class="row">
        <label>Check-in <input name="check_in" type="date" required /></label>
        <label>Check-out <input name="check_out" type="date" required /></label>
      </div>
      <div class="row">
        <label>Room type
          <select name="room" id="room">
            {rooms.map((r) => <option value={r.slug}>{r.name}</option>)}
          </select>
        </label>
        <label>Guests <input name="guests" type="number" min="1" max="10" value="2" /></label>
      </div>
      <label>Message (optional) <textarea name="message" rows="3"></textarea></label>
      <button class="btn" type="submit">Send enquiry</button>
    </form>
  </section>
</BaseLayout>

<script>
  // Pre-select room when arriving from a "Book this room" link
  const room = new URLSearchParams(location.search).get('room');
  const select = document.getElementById('room') as HTMLSelectElement | null;
  if (room && select) select.value = room;
</script>

<style>
  .actions { display: flex; gap: 12px; flex-wrap: wrap; margin: 20px 0 32px; }
</style>
