---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import OfferBanner from '../components/OfferBanner.astro';
import Web3Form from '../components/Web3Form.astro';
import site from '../data/site.json';
import venues from '../data/venues.json';
import events from '../data/events.json';
import { discount } from '../lib/offer';
import { waHref } from '../lib/links';

const hall = venues.find((v) => v.slug === 'sabha')!;
const sessions = ['Morning', 'Afternoon', 'Evening', 'Full day'];
---
<BaseLayout title="Banquet Hall" description={`Sabha – The Banquet at Hotel Living Hub: AC hall for weddings, corporate events, family functions, social events and political meetings. Book online and get ${discount}% off the hall rent.`}>
  <PageHero title="Sabha – The Banquet" lead="An AC banquet hall for weddings, corporate events, family functions and public meetings." image="/images/dining/sobha-3.webp" />

  <section class="section container">
    <OfferBanner what="the banquet hall" on="the hall rent" href="#enquire" cta="Book the hall" />

    <p class="type">{hall.type}</p>
    <h2>One hall, every occasion</h2>
    <p class="desc">{hall.description} Catering comes from our own restaurant, Taste Point, and your guests can stay with us in the hotel.</p>
    <div class="photo-row">
      <img src={hall.image} alt={hall.name} loading="lazy" width="800" height="600" />
      {hall.photos.map((p) => <img src={p.src} alt={p.alt} loading="lazy" width="800" height="600" />)}
    </div>
  </section>

  <section class="section band">
    <div class="container">
      <h2>Events we host</h2>
      <div class="grid">
        {events.map((e) => (
          <article class="card card-body event" id={e.slug}>
            <h3>{e.name}</h3>
            <p class="muted">{e.description}</p>
            <ul class="checks">
              {e.includes.map((i) => <li>{i}</li>)}
            </ul>
            <a class="btn" href={`?event=${e.slug}#enquire`} data-event={e.slug}>Book for {e.name.toLowerCase()}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section container split" id="enquire">
    <div>
      <h2>Book the hall</h2>
      <p class="muted intro">Tell us about your event. We'll confirm availability and send a quote with {discount}% off the hall rent.</p>
      <Web3Form subject={`New banquet booking (${discount}% web offer)`} sheet="Banquet" id="banquet-form">
        <label>Name <input name="name" required autocomplete="name" /></label>
        <div class="row">
          <label>Phone <input name="phone" type="tel" required autocomplete="tel" /></label>
          <label>Email (optional) <input name="email" type="email" autocomplete="email" /></label>
        </div>
        <label>Organisation or family name (optional) <input name="organisation" autocomplete="organization" /></label>
        <div class="row">
          <label>Event type
            <select name="event_type" required>
              {events.map((e) => <option value={e.slug}>{e.name}</option>)}
              <option value="other">Other</option>
            </select>
          </label>
          <label>Event date <input name="date" type="date" required /></label>
        </div>
        <div class="row">
          <label>Session
            <select name="session">
              {sessions.map((s) => <option>{s}</option>)}
            </select>
          </label>
          <label>Expected guests <input name="guests" type="number" min="1" required /></label>
        </div>
        <div class="row">
          <label>Catering
            <select name="catering">
              <option>Yes, from Taste Point</option>
              <option>Tea and snacks only</option>
              <option>No catering</option>
            </select>
          </label>
          <label>Rooms for guests <input name="rooms_needed" type="number" min="0" value="0" /></label>
        </div>
        <label>Details (optional) <textarea name="message" rows="3" placeholder="Seating style, decor, stage, sound, menu ideas"></textarea></label>
        <button class="btn" type="submit">Send booking request</button>
      </Web3Form>
    </div>
    <div class="aside">
      <h3>Prefer to talk?</h3>
      <p class="muted">Call or WhatsApp us to visit the hall before you book. The {discount}% web offer still applies when you send your request here first.</p>
      <a class="btn btn-whatsapp" href={waHref(`Hi, I'd like to book Sabha – The Banquet at ${site.name}.`)} target="_blank" rel="noopener">WhatsApp us</a>
      <img src="/images/dining/sobha-2.webp" alt="Sabha banquet hall set up for a meeting" loading="lazy" width="800" height="600" />
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('banquet-form') as HTMLFormElement;
  const type = form.elements.namedItem('event_type') as HTMLSelectElement;
  const date = form.elements.namedItem('date') as HTMLInputElement;
  const d = new Date();
  date.min = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

  const pick = (slug: string | null) => {
    if (slug && Array.from(type.options).some((o) => o.value === slug)) type.value = slug;
  };
  pick(new URLSearchParams(location.search).get('event'));

  // Choosing an event card pre-selects it in the form without reloading the page.
  for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-event]')) {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      pick(link.dataset.event!);
      document.getElementById('enquire')!.scrollIntoView({ behavior: 'smooth' });
      (form.elements.namedItem('name') as HTMLInputElement).focus({ preventScroll: true });
    });
  }
</script>

<style>
  .type { color: var(--forest); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; }
  .desc { margin-bottom: 16px; max-width: 760px; }
  .intro { margin-bottom: 14px; }
  .event { display: grid; gap: 10px; align-content: start; }
  .event .checks { grid-template-columns: 1fr; font-size: 0.95rem; }
  .event .btn { justify-self: start; margin-top: 4px; }
  .split { display: grid; gap: 40px; grid-template-columns: 1fr 1fr; align-items: start; }
  .aside { display: grid; gap: 12px; justify-items: start; }
  .aside img { border-radius: var(--radius); aspect-ratio: 4 / 3; object-fit: cover; width: 100%; margin-top: 8px; }

  @media (max-width: 800px) {
    .split { grid-template-columns: 1fr; }
  }
</style>
