---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookingCta from '../components/BookingCta.astro';
import venues from '../data/venues.json';
---
<BaseLayout title="Dining & Restaurant" description="Taste Point restaurant, Madira lounge bar and Sobha banquet hall at Hotel Living Hub.">
  <PageHero title="Dining & Restaurant" lead="Food, drinks and celebrations without leaving the hotel." image="/images/dining/taste-point.webp" />

  <section class="section container venues">
    {venues.map((v) => (
      <article id={v.slug}>
        <p class="type">{v.type}</p>
        <h2>{v.name}</h2>
        <p class="desc">{v.description}</p>
        <div class="photo-row">
          <img src={v.image} alt={v.name} loading="lazy" width="800" height="600" />
          {v.photos.map((p) => <img src={p.src} alt={p.alt} loading="lazy" width="800" height="600" />)}
        </div>
      </article>
    ))}
  </section>

  <BookingCta title="Planning a meal, a stay or an event? Talk to us." />
</BaseLayout>

<style>
  .venues { display: grid; gap: 48px; }
  .type { color: var(--forest); font-weight: 700; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; }
  article h2 { margin-bottom: 6px; }
  .desc { margin-bottom: 16px; max-width: 720px; }
</style>
