---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BookingCta from '../components/BookingCta.astro';

const groups = [
  {
    title: 'Rooms',
    photos: [
      { src: '/images/rooms/deluxe-2.webp', alt: 'Deluxe Room' },
      { src: '/images/rooms/executive.webp', alt: 'Executive Room' },
      { src: '/images/rooms/suite.webp', alt: 'Suite Room' },
      { src: '/images/rooms/suite-3.webp', alt: 'Suite sitting room' },
      { src: '/images/gallery/room.webp', alt: 'Guest room' },
      { src: '/images/rooms/executive-bath.webp', alt: 'Attached bathroom' },
    ],
  },
  {
    title: 'Taste Point restaurant',
    photos: [
      { src: '/images/dining/taste-point.webp', alt: 'Taste Point dining room' },
      { src: '/images/dining/taste-point-2.webp', alt: 'Dining tables' },
      { src: '/images/dining/taste-point-3.webp', alt: 'Table setting' },
      { src: '/images/dining/taste-point-lounge.webp', alt: 'Lounge seating' },
    ],
  },
  {
    title: 'Madira – The Bar',
    photos: [
      { src: '/images/dining/madira.webp', alt: 'Bar counter' },
      { src: '/images/dining/madira-2.webp', alt: 'Backlit bar shelves' },
      { src: '/images/dining/madira-3.webp', alt: 'Lounge seating' },
      { src: '/images/dining/madira-booth.webp', alt: 'Private booth' },
    ],
  },
  {
    title: 'Sobha – The Banquet',
    photos: [
      { src: '/images/dining/sobha.webp', alt: 'Theatre-style seating' },
      { src: '/images/dining/sobha-2.webp', alt: 'Meeting setup with screen' },
      { src: '/images/dining/sobha-3.webp', alt: 'Round table setup' },
    ],
  },
  {
    title: 'The hotel',
    photos: [
      { src: '/images/gallery/exterior.webp', alt: 'Hotel entrance at night' },
      { src: '/images/gallery/sign.webp', alt: 'Living Hub sign' },
      { src: '/images/gallery/entrance.webp', alt: 'Entrance' },
      { src: '/images/gallery/reception.webp', alt: 'Reception' },
      { src: '/images/gallery/corridor.webp', alt: 'Corridor' },
      { src: '/images/gallery/sitting.webp', alt: 'Sitting area' },
    ],
  },
];
---
<BaseLayout title="Gallery" description="Photos of rooms, dining, the lounge bar and banquet hall at Hotel Living Hub.">
  <PageHero title="Gallery" lead="Take a look around before you arrive." image="/images/gallery/lounge.webp" />

  <section class="section container groups">
    {groups.map((g) => (
      <div>
        <h2>{g.title}</h2>
        <div class="gallery">
          {g.photos.map((p) => (
            <figure>
              <a href={p.src} class="zoom" data-caption={p.alt} aria-label={`View larger photo: ${p.alt}`}>
                <img src={p.src} alt={p.alt} loading="lazy" width="800" height="600" />
              </a>
              <figcaption>{p.alt}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    ))}
  </section>

  <dialog class="lightbox" id="lightbox" aria-label="Photo viewer">
    <figure>
      <img id="lb-img" alt="" />
      <figcaption id="lb-caption"></figcaption>
    </figure>
    <button type="button" class="lb-btn lb-close" aria-label="Close" data-lb="close">&times;</button>
    <button type="button" class="lb-btn lb-prev" aria-label="Previous photo" data-lb="prev">&lsaquo;</button>
    <button type="button" class="lb-btn lb-next" aria-label="Next photo" data-lb="next">&rsaquo;</button>
  </dialog>

  <BookingCta />
</BaseLayout>

<script>
  // Click a gallery photo to view it large. Without JS the link still opens the image.
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('a.zoom'));
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lb-img') as HTMLImageElement;
  const caption = document.getElementById('lb-caption')!;
  let current = 0;

  function show(i: number) {
    current = (i + links.length) % links.length;
    const link = links[current];
    img.src = link.href;
    img.alt = link.dataset.caption ?? '';
    caption.textContent = `${link.dataset.caption ?? ''}  (${current + 1} / ${links.length})`;
  }

  links.forEach((link, i) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      show(i);
      dialog.showModal();
    });
  });

  dialog.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest<HTMLElement>('[data-lb]')?.dataset.lb;
    if (action === 'prev') show(current - 1);
    else if (action === 'next') show(current + 1);
    else if (action === 'close' || target === dialog || target.tagName === 'FIGURE') dialog.close();
  });

  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft') show(current - 1);
    if (e.key === 'ArrowRight') show(current + 1);
  });

  // Swipe left/right on phones.
  let startX = 0;
  dialog.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
  dialog.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - startX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
  });
</script>

<style>
  .groups { display: grid; gap: 40px; }
  .gallery { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  figure img { aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius); background: var(--surface); width: 100%; }
  figcaption { font-size: 0.9rem; color: var(--muted); padding-top: 4px; }

  .zoom { display: block; overflow: hidden; border-radius: var(--radius); cursor: zoom-in; }
  .zoom img { transition: transform 0.3s; }
  .zoom:hover img { transform: scale(1.04); }
  .zoom:focus-visible { outline: 2px solid var(--forest); outline-offset: 2px; }

  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none;
    margin: 0; padding: 0; border: 0;
    background: rgb(0 0 0 / 0.92); color: #fff;
  }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox figure { display: grid; justify-items: center; gap: 10px; padding: 56px 16px 24px; width: 100%; height: 100%; align-content: center; }
  .lightbox img { max-width: min(100%, 1280px); max-height: calc(100dvh - 120px); width: auto; height: auto; object-fit: contain; border-radius: 6px; aspect-ratio: auto; background: none; cursor: default; }
  .lightbox figcaption { color: #eee; font-size: 0.95rem; text-align: center; padding: 0; }

  .lb-btn {
    position: absolute; display: grid; place-items: center;
    width: 48px; height: 48px; border: 0; border-radius: 50%;
    background: rgb(255 255 255 / 0.15); color: #fff;
    font-size: 2rem; line-height: 1; cursor: pointer;
  }
  .lb-btn:hover { background: rgb(255 255 255 / 0.3); }
  .lb-btn:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .lb-close { top: 12px; right: 12px; }
  .lb-prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 12px; top: 50%; transform: translateY(-50%); }

  :global(html:has(dialog[open])) { overflow: hidden; }

  @media (max-width: 600px) {
    .lb-prev, .lb-next { top: auto; bottom: 16px; transform: none; }
    .lightbox figure { padding-bottom: 80px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .zoom img { transition: none; }
    .zoom:hover img { transform: none; }
  }
</style>
