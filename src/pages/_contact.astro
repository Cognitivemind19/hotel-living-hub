---
import BaseLayout from '../layouts/BaseLayout.astro';
import site from '../data/site.json';
---
<BaseLayout title="Contact" description="Phone, WhatsApp, email and address for Hotel Living Hub.">
  <section class="section container">
    <h1>Contact us</h1>
    <dl class="contact">
      <dt>Phone</dt><dd><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></dd>
      <dt>WhatsApp</dt><dd><a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener">Chat with us</a></dd>
      <dt>Email</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
      <dt>Address</dt><dd>{site.address}</dd>
      <dt>Check-in</dt><dd>{site.checkIn}</dd>
      <dt>Check-out</dt><dd>{site.checkOut}</dd>
    </dl>
  </section>
</BaseLayout>

<style>
  .contact { display: grid; grid-template-columns: max-content 1fr; gap: 10px 24px; max-width: 560px; }
  dt { font-weight: 600; }
</style>
