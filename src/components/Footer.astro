---
import site from '../data/site.json';
const year = new Date().getFullYear();
const social = Object.entries(site.social).filter(([, url]) => url);
---
<footer class="site-footer">
  <div class="container cols">
    <div>
      <strong>{site.name}</strong>
      <p>{site.address}</p>
    </div>
    <div>
      <p><a href={`tel:${site.phone.replace(/\s/g, '')}`}>{site.phone}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p>Check-in {site.checkIn} · Check-out {site.checkOut}</p>
    </div>
    {social.length > 0 && (
      <div>
        {social.map(([name, url]) => <p><a href={url} rel="noopener">{name}</a></p>)}
      </div>
    )}
  </div>
  <p class="container copy">© {year} {site.name}</p>
</footer>

<style>
  .site-footer { background: var(--surface); padding: 32px 0 16px; margin-top: 48px; font-size: 0.95rem; }
  .cols { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .copy { margin-top: 20px; color: var(--muted); font-size: 0.85rem; }
  a { text-transform: capitalize; }
</style>
