---
interface Props {
  title: string;
  lead?: string;
  image?: string;
}
const { title, lead, image } = Astro.props;
---
<section class="page-hero" style={image ? `--hero: url('${image}')` : undefined}>
  <div class="container">
    <h1>{title}</h1>
    {lead && <p>{lead}</p>}
  </div>
</section>

<style>
  .page-hero {
    background: linear-gradient(rgb(0 0 0 / 0.5), rgb(0 0 0 / 0.5)), var(--hero, none) center / cover, var(--forest);
    color: #fff;
    padding: 64px 0;
  }
  h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.2; }
  p { font-size: 1.1rem; margin-top: 8px; max-width: 640px; }
</style>
