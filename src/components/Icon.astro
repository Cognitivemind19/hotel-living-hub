---
import icons from '../data/icons.json';

interface Props {
  name: keyof typeof icons;
  size?: number;
}
const { name, size = 44 } = Astro.props;
const { viewBox, d } = icons[name];
---
<span class={`icon icon-${name}`} style={`--size:${size}px`} aria-hidden="true">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox={viewBox}><!-- Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (CC BY 4.0) --><path d={d} /></svg>
</span>

<style>
  .icon {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: calc(var(--size) * 0.3);
    color: #fff;
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.28), 0 4px 10px rgb(0 0 0 / 0.2);
  }
  svg { width: 50%; height: 50%; fill: currentColor; }

  .icon-facebook { background: linear-gradient(145deg, #3b8ff5, #1259c3); }
  .icon-instagram { background: radial-gradient(circle at 30% 107%, #fdc468 0%, #fa7e1e 28%, #d62976 58%, #962fbf 82%, #4f5bd5 100%); }
  .icon-linkedin { background: linear-gradient(145deg, #1a84e0, #0a4f9a); }
  .icon-x { background: linear-gradient(145deg, #3a3a3a, #000); }
  .icon-whatsapp { background: linear-gradient(145deg, #2ad36b, #128c7e); }
  .icon-phone { background: linear-gradient(145deg, #ea7a1f, #c2410c); }
  .icon-email { background: linear-gradient(145deg, #6366f1, #4338ca); }
  .icon-address { background: linear-gradient(145deg, #e11d48, #9f1239); }
  .icon-check-in { background: linear-gradient(145deg, #0d9488, #115e59); }
  .icon-check-out { background: linear-gradient(145deg, #a2653f, #6b3a20); }
</style>
