---
interface Props {
  room: {
    slug: string;
    name: string;
    price: number;
    guests: number;
    bed: string;
    image: string;
    amenities: string[];
  };
}
const { room } = Astro.props;
---
<article class="card" id={room.slug}>
  <img src={room.image} alt={room.name} loading="lazy" width="800" height="600" />
  <div class="card-body">
    <h3>{room.name}</h3>
    <p class="muted">{room.bed} · Up to {room.guests} guests</p>
    <ul class="tags">
      {room.amenities.map((a) => <li>{a}</li>)}
    </ul>
    <p><strong>From ₹{room.price.toLocaleString('en-IN')}</strong> / night</p>
    <a class="btn" href={`/book/?room=${room.slug}`} style="margin-top:10px">Book this room</a>
  </div>
</article>
