---
import '../styles/global.css';
import site from '../data/site.json';

const title = `${site.name} — Coming soon`;
const description = `${site.name} — ${site.tagline}. Our website is coming soon.`;
const ogImage = new URL('/images/brand/og-image.png', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
  </head>
  <body>
    <main class="coming-soon">
      <h1><img src="/images/brand/logo-stacked-white.svg" alt={site.name} width="1200" height="1531" /></h1>
      <p class="eyebrow">Coming soon</p>
      <p class="tagline">{site.tagline}</p>
    </main>
  </body>
</html>

<style>
  .coming-soon {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 12px;
    padding: 32px 16px;
    text-align: center;
    color: #fff;
    background: #195a32;
  }
  h1 img {
    width: min(70vw, 280px);
    height: auto;
    margin-bottom: 20px;
  }
  .eyebrow {
    font-weight: 600;
    font-size: 1.1rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .tagline {
    opacity: 0.85;
    font-size: 1.05rem;
  }
</style>
