---
import { discount, inr, withDiscount } from '../lib/offer';

interface Props {
  /** Single-occupancy rate per night. */
  price: number | null;
  /** Double-occupancy rate per night, when it differs. */
  priceDouble?: number | null;
}
const { price, priceDouble } = Astro.props;
---
{price
  ? priceDouble
    ? <div class="room-price">
        <p>Single <span class="was">{inr(price)}</span><strong>{inr(withDiscount(price))}</strong> / night</p>
        <p>Double <span class="was">{inr(priceDouble)}</span><strong>{inr(withDiscount(priceDouble))}</strong> / night</p>
        <p class="save">{discount}% off when you book online</p>
      </div>
    : <p>From <span class="was">{inr(price)}</span><strong>{inr(withDiscount(price))}</strong> / night <span class="save">{discount}% off when you book online</span></p>
  : <p class="muted">Contact us for today's rate · {discount}% off when you book online</p>}

<style>
  .room-price p { margin: 0; }
  .room-price .save { margin-top: 2px; }
</style>
