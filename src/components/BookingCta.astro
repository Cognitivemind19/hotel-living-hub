---
import site from '../data/site.json';
import { telHref, waHref } from '../lib/links';

interface Props {
  title?: string;
}
const { title = 'Ready to book your stay?' } = Astro.props;
---
<section class="band cta">
  <div class="container">
    <h2>{title}</h2>
    <div class="actions">
      <a class="btn btn-whatsapp" href={waHref(`Hi, I'd like to book a stay at ${site.name}.`)} target="_blank" rel="noopener">WhatsApp booking</a>
      <a class="btn" href={telHref}>Call {site.phone}</a>
      <a class="btn" href="/book/">Online reservation</a>
    </div>
  </div>
</section>

<style>
  .cta { padding: 40px 0; text-align: center; }
  h2 { margin-bottom: 16px; line-height: 1.2; }
  .actions { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
</style>
